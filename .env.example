# API runtime
UTILITY_API_HOST=0.0.0.0
UTILITY_API_PORT=3010

# Persistence mode: memory | mysql
UTILITY_PERSISTENCE_MODE=memory

# MySQL settings (required when UTILITY_PERSISTENCE_MODE=mysql)
UTILITY_MYSQL_HOST=127.0.0.1
UTILITY_MYSQL_PORT=3306
UTILITY_MYSQL_USER=utility_app
UTILITY_MYSQL_PASSWORD=utility_app_password
UTILITY_MYSQL_DATABASE=utility_billing
UTILITY_MYSQL_CONNECTION_LIMIT=8
