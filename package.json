{
    "name": "strategies",
    "version": "1.0.0",
    "main": "dist/main.js",
    "types": "dist/main.d.ts",
    "imports": {
        "#applications/*":  "./dist/applications/*.js",
        "#factories/*":     "./dist/factories/*.js",
        "#interfaces/*":    "./dist/interfaces/*.js",
        "#processors/*":    "./dist/processors/*.js",
        "#products/*":      "./dist/products/*.js",
        "#strategies/*":    "./dist/strategies/*.js",
        "#types/*":         "./dist/types/*.js",
        "#workflows/*":     "./dist/workflows/*.js"
    },
    "scripts": {
        "build": "npx tsc",
        "clean": "rm -rf dist tsconfig.tsbuildinfo",
        "start": "npm run build && node dist/main.js",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "devDependencies": {
        "@types/node": "^26.5.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    }
}